[Unit]
Description=S3 Bypass Protocol — fedarisha server (our hardened core)
Documentation=https://github.com/thevladimirzh/s3-bypass-protocol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3bypass
Group=s3bypass
WorkingDirectory=/opt/s3bypass-protocol

# The server config holds storage credentials — keep it root-owned, mode 0640,
# group s3bypass (the User= above). A root-owned 0600 file is unreadable by the
# very process it was written for; see deploy/VPS-DEPLOY.ru.md.
ExecStartPre=/usr/bin/test -r /etc/s3bypass-protocol/server.json
ExecStart=/opt/s3bypass-protocol/xray run -c /etc/s3bypass-protocol/server.json
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s
# Backing off hard on a broken config is better than a restart loop that
# hammers the S3 API.
StartLimitIntervalSec=60
StartLimitBurst=5

# The core logs to stdout; let journald keep it.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=s3bypass-protocol

# Hardening: this process needs its config and the network, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/opt/s3bypass-protocol
# The only writable path is its own state dir, not needed today — the server is
# stateless apart from the bucket.
#
# No hyphen before "bypass": install-server.sh creates
# /var/lib/s3bypass-protocol (STATE_DIR, line 15) and every other path in this
# unit spells it the same way. The stray "s3-bypass-protocol" here made the
# unit fail before it ever ran —
#   Failed to set up mount namespacing: /var/lib/s3-bypass-protocol:
#   No such file or directory
# and the service never reached ExecStart. Observed on a real install
# 2026-10-12; verified fixed by installing from this unit and watching the
# process start.
ReadWritePaths=/var/lib/s3bypass-protocol
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target